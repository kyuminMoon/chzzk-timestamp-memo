{
  "manifest_version": 3,
  "name": "합방 타임스탬프 메모 (치지직용)",
  "short_name": "합방 메모",
  "version": "1.0.0",
  "description": "치지직 합방 중 한 번의 메모로 스트리머마다 방송 시각을 저장하고, 'HH:mm:ss 메모' 타임스탬프 댓글로 바로 복사합니다.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "합방 타임스탬프 메모 열기",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://api.chzzk.naver.com/*"]
}
